---
export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = "", ogImage } = Astro.props;
const siteTitle = "スマート比較ナビ";
const fullTitle = `${title} | ${siteTitle}`;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}

    <!-- OGP -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:type" content="article" />
    {description && <meta property="og:description" content={description} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/affiliate-engine/favicon.svg" />
    <link rel="sitemap" href="/affiliate-engine/sitemap-index.xml" />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="border-b border-zinc-200 bg-white">
      <nav class="mx-auto max-w-4xl px-4 py-4">
        <a href="/affiliate-engine/" class="text-xl font-bold text-brand-700 no-underline">
          {siteTitle}
        </a>
        <p class="mt-1 text-xs text-zinc-500">
          データで比較する、賢い買い物ガイド
        </p>
      </nav>
    </header>

    <main class="mx-auto w-full max-w-4xl flex-1 px-4 py-8">
      <slot />
    </main>

    <footer class="border-t border-zinc-200 bg-zinc-100 text-xs text-zinc-500">
      <div class="mx-auto max-w-4xl px-4 py-6 space-y-2">
        <p>
          当サイトはアフィリエイトプログラム（Amazon アソシエイト、楽天アフィリエイト）に
          参加しています。リンク経由の購入により、当サイトが紹介料を受け取る場合があります。
        </p>
        <p>
          価格情報は記事更新時点のものです。最新の価格・在庫は各販売サイトでご確認ください。
        </p>
        <p class="pt-2">&copy; {new Date().getFullYear()} {siteTitle}</p>
      </div>
    </footer>
  </body>
</html>
