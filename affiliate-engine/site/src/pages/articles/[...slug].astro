---
/**
 * Backward-compat redirect: /articles/:slug → /blog/:slug
 * Keeps old GitHub Pages URLs working after migration to Vercel.
 */
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.data.urlSlug },
    props: { slug: post.data.urlSlug },
  }));
}

const { slug } = Astro.props;
return Astro.redirect(`/blog/${slug}/`, 301);
---
