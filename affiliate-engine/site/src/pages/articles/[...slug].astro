---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ScoreBadge from "../../components/ScoreBadge.astro";
import TableOfContents from "../../components/TableOfContents.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles.map((article) => ({
    params: { slug: article.data.urlSlug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const { title, description, keyword, updatedAt, createdAt, urlSlug, articleType, rating, category } = article.data;
const isReview = articleType === "review";
const base = import.meta.env.BASE_URL;
const ogImage = `${Astro.site}${base.slice(1)}ogp/${urlSlug}.png`;
const articleUrl = `${Astro.site}${base.slice(1)}articles/${urlSlug}/`;

// Build JSON-LD for review articles
let jsonLd: Record<string, unknown> | undefined;
if (isReview && rating) {
  jsonLd = {
    "@context": "https://schema.org",
    "@type": "Review",
    "itemReviewed": {
      "@type": "Product",
      "name": keyword,
      "category": category || "お酒",
    },
    "reviewRating": {
      "@type": "Rating",
      "ratingValue": rating,
      "bestRating": 5,
      "worstRating": 1,
    },
    "author": { "@type": "Person", "name": "Drunken Logic" },
    "publisher": { "@type": "Organization", "name": "Drunken Logic" },
    "description": description,
    "datePublished": createdAt.toISOString(),
    "dateModified": updatedAt.toISOString(),
    "url": articleUrl,
  };
}
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <div class="relative">
    <!-- Floating TOC (desktop only) -->
    <TableOfContents headings={headings} />

    <article class="article-content max-w-3xl mx-auto">
      {/* ── Hero Section ── */}
      {isReview ? (
        <header class="mb-10 rounded-2xl bg-gradient-to-br from-zinc-900 to-zinc-800 text-white p-8 sm:p-10">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
            <div class="flex-1">
              <span class="inline-block rounded-full bg-amber-500/20 px-3 py-1 text-xs font-medium text-amber-300 mb-4">
                実体験レビュー
              </span>
              <h1 class="text-2xl sm:text-3xl font-bold leading-tight font-display">
                {title}
              </h1>
              <p class="mt-3 text-sm text-zinc-400">{keyword}</p>
              <time
                class="mt-2 block text-xs text-zinc-500"
                datetime={updatedAt.toISOString()}
              >
                最終更新: {updatedAt.toLocaleDateString("ja-JP")}
              </time>
            </div>
            {rating && (
              <div class="flex-shrink-0">
                <ScoreBadge rating={rating} size="lg" />
              </div>
            )}
          </div>
        </header>
      ) : (
        <header class="mb-8">
          <span class="mb-3 inline-block rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
            {keyword}
          </span>
          <h1 class="text-2xl font-bold leading-tight text-zinc-900 sm:text-3xl">
            {title}
          </h1>
          <time
            class="mt-3 block text-sm text-zinc-500"
            datetime={updatedAt.toISOString()}
          >
            最終更新: {updatedAt.toLocaleDateString("ja-JP")}
          </time>
        </header>
      )}

      {/* ── Article Body ── */}
      <div class="prose prose-zinc max-w-none">
        <Content />
      </div>
    </article>
  </div>
</BaseLayout>
