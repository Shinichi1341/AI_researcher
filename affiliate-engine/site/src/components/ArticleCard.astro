---
export interface Props {
  title: string;
  description: string;
  slug: string;
  keyword: string;
  updatedAt: Date;
}

const { title, description, slug, keyword, updatedAt } = Astro.props;
---

<a
  href={`/affiliate-engine/articles/${slug}/`}
  class="block rounded-lg border border-zinc-200 bg-white p-5 transition hover:border-brand-500 hover:shadow-md no-underline"
>
  <span
    class="mb-2 inline-block rounded bg-brand-50 px-2 py-0.5 text-xs font-medium text-brand-700"
  >
    {keyword}
  </span>
  <h2 class="text-lg font-bold text-zinc-900 leading-snug">{title}</h2>
  <p class="mt-2 text-sm text-zinc-600 line-clamp-2">{description}</p>
  <time class="mt-3 block text-xs text-zinc-400" datetime={updatedAt.toISOString()}>
    更新: {updatedAt.toLocaleDateString("ja-JP")}
  </time>
</a>
