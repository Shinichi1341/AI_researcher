---
export interface Props {
  title: string;
  description: string;
  slug: string;
  keyword: string;
  articleType: string;
  updatedAt: Date;
}

const { title, description, slug, keyword, articleType, updatedAt } = Astro.props;
const isReview = articleType === "review";
const base = import.meta.env.BASE_URL;
---

<a
  href={`${base}articles/${slug}/`}
  class="block rounded-lg border border-zinc-200 bg-white p-5 transition hover:border-brand-500 hover:shadow-md no-underline"
>
  <div class="mb-2 flex items-center gap-2">
    <span
      class="inline-block rounded bg-brand-50 px-2 py-0.5 text-xs font-medium text-brand-700"
    >
      {keyword}
    </span>
    {isReview && (
      <span class="inline-block rounded bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700">
        実体験レビュー
      </span>
    )}
  </div>
  <h2 class="text-lg font-bold text-zinc-900 leading-snug">{title}</h2>
  <p class="mt-2 text-sm text-zinc-600 line-clamp-2">{description}</p>
  <time class="mt-3 block text-xs text-zinc-400" datetime={updatedAt.toISOString()}>
    更新: {updatedAt.toLocaleDateString("ja-JP")}
  </time>
</a>
