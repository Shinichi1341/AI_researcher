---
import ScoreBadge from "./ScoreBadge.astro";

export interface Props {
  title: string;
  description: string;
  slug: string;
  keyword: string;
  articleType: string;
  updatedAt: Date;
  rating?: number;
  author?: string;
  tags?: string[];
}

const { title, description, slug, keyword, articleType, updatedAt, rating, author, tags = [] } = Astro.props;
const isReview = articleType === "review";
const isHybrid = author === "hybrid";

const typeLabel: Record<string, { text: string; class: string }> = {
  review:        { text: "レビュー",     class: "bg-amber-500/15 text-amber-400 ring-amber-500/20" },
  comparison:    { text: "比較",         class: "bg-blue-500/15 text-blue-400 ring-blue-500/20" },
  spec_analysis: { text: "スペック分析", class: "bg-emerald-500/15 text-emerald-400 ring-emerald-500/20" },
  price_watch:   { text: "価格動向",     class: "bg-purple-500/15 text-purple-400 ring-purple-500/20" },
  tool:          { text: "ツール",       class: "bg-rose-500/15 text-rose-400 ring-rose-500/20" },
};

const badge = typeLabel[articleType] ?? typeLabel.review;
---

<a
  href={`/blog/${slug}/`}
  class="group relative block rounded-2xl border border-zinc-800 bg-zinc-900/50 p-6 transition-all duration-300
         hover:border-amber-500/40 hover:bg-zinc-900 hover:shadow-[0_0_30px_-5px_rgba(245,158,11,0.15)] no-underline"
>
  {/* Glow effect on hover */}
  <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-amber-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />

  <div class="relative flex items-start justify-between gap-4">
    <div class="flex-1 min-w-0">
      {/* Badges */}
      <div class="mb-3 flex items-center gap-2 flex-wrap">
        <span class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-[11px] font-medium ring-1 ring-inset ${badge.class}`}>
          {badge.text}
        </span>
        {isHybrid && (
          <span class="inline-flex items-center rounded-full bg-gradient-to-r from-amber-500/15 to-orange-500/15 px-2.5 py-0.5 text-[11px] font-medium text-amber-300 ring-1 ring-inset ring-amber-500/20">
            🥃 Drunken Logic
          </span>
        )}
        {isReview && !isHybrid && (
          <span class="inline-flex items-center rounded-full bg-zinc-800 px-2.5 py-0.5 text-[11px] font-medium text-zinc-400 ring-1 ring-inset ring-zinc-700">
            {keyword}
          </span>
        )}
      </div>

      {/* Title */}
      <h2 class="text-lg font-bold text-white leading-snug group-hover:text-amber-400 transition-colors duration-200">
        {title}
      </h2>

      {/* Description */}
      <p class="mt-2 text-sm text-zinc-400 line-clamp-2 leading-relaxed">{description}</p>

      {/* Tags */}
      {tags.length > 0 && (
        <div class="mt-3 flex gap-1.5 flex-wrap">
          {tags.slice(0, 3).map((tag) => (
            <span class="text-[10px] text-zinc-500 bg-zinc-800/50 rounded-md px-2 py-0.5">
              #{tag}
            </span>
          ))}
        </div>
      )}

      {/* Date */}
      <time class="mt-3 block text-xs text-zinc-600" datetime={updatedAt.toISOString()}>
        {updatedAt.toLocaleDateString("ja-JP")}
      </time>
    </div>

    {/* Rating badge */}
    {rating && (
      <div class="flex-shrink-0">
        <ScoreBadge rating={rating} size="sm" />
      </div>
    )}
  </div>
</a>
