---
import ScoreBadge from "./ScoreBadge.astro";

export interface Props {
  title: string;
  description: string;
  slug: string;
  keyword: string;
  articleType: string;
  updatedAt: Date;
  rating?: number;
}

const { title, description, slug, keyword, articleType, updatedAt, rating } = Astro.props;
const isReview = articleType === "review";
const base = import.meta.env.BASE_URL;
---

<a
  href={`${base}articles/${slug}/`}
  class="group block rounded-xl border border-zinc-200 bg-white p-6 transition-all hover:border-amber-400 hover:shadow-lg no-underline"
>
  <div class="flex items-start justify-between gap-4">
    <div class="flex-1 min-w-0">
      <div class="mb-2 flex items-center gap-2 flex-wrap">
        {isReview && (
          <span class="inline-block rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-medium text-amber-700">
            実体験レビュー
          </span>
        )}
        <span class="inline-block rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs font-medium text-zinc-500">
          {keyword}
        </span>
      </div>
      <h2 class="text-lg font-bold text-zinc-900 leading-snug group-hover:text-amber-700 transition-colors">
        {title}
      </h2>
      <p class="mt-2 text-sm text-zinc-500 line-clamp-2">{description}</p>
      <time class="mt-3 block text-xs text-zinc-300" datetime={updatedAt.toISOString()}>
        {updatedAt.toLocaleDateString("ja-JP")}
      </time>
    </div>
    {rating && (
      <div class="flex-shrink-0">
        <ScoreBadge rating={rating} size="sm" />
      </div>
    )}
  </div>
</a>
