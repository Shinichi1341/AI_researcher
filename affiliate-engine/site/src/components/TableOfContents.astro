---
export interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;
const tocItems = headings.filter((h) => h.depth === 2);
---

{tocItems.length > 0 && (
  <nav class="toc hidden xl:block fixed top-24 right-[max(1rem,calc(50%-40rem))] w-56">
    <p class="text-xs font-semibold text-zinc-500 uppercase tracking-wider mb-3">目次</p>
    <ul class="space-y-2 text-sm border-l-2 border-zinc-800 pl-4">
      {tocItems.map((item) => (
        <li>
          <a
            href={`#${item.slug}`}
            class="text-zinc-500 hover:text-amber-400 no-underline transition-colors block leading-snug"
          >
            {item.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
